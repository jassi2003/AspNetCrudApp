@model List<formApp.Models.FormModel>


<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title></title>
<link href="~/css/formindex.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="page-header">
        <div class="page-header-left">
            <div class="page-eyebrow">Data Management</div>
            <h1 class="page-title">All Records</h1>
            <p class="page-subtitle">Manage and track all your user entries in one place.</p>
        </div>
        <!-- In Razor: <a asp-action="Create" class="btn-add"> -->
        <a asp-action="Create" class="btn-add">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
            Add New Record
        </a>
    </div>



    <div class="table-card">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Age</th>
                        <th>Phone</th>
                        <th>City</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Any() != true)
                        {
                            <tr>
                                <td colspan="6">No records found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {

                                <tr>
                                    <td><span class="td-id">@item.Id</span></td>
                                    <td>
                                        <span class="td-name">
                                        <span class="avatar">
                                            @{
                                                var names = item.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                                var initials = names.Length > 1
                                                    ? $"{names[0][0]}{names[1][0]}"
                                                    : $"{names[0][0]}";
                                            }
                                            @initials.ToUpper()
                                        </span>
                                        @item.Name
                                        </span>
                                    </td>
                                    <td class="td-email">@item.Email</td>
                                    <td><span class="td-age">@item.Age</span></td>
                                    <td class="td-phone">8287068145</td>
                                    <td><span class="city-badge">📍 @item.City</span></td>
                                    <td>
                                        <div class="actions-cell">
                                            <!-- In Razor: <a asp-action="Edit" asp-route-id= class="btn-edit"> -->
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-edit">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                                Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-delete">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v6M14 11v6" /><path d="M9 6V4h6v2" /></svg>
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                          
                            }
                        }
                    </tbody>
            </table>
        </div>
    </div>
</body>
</html>