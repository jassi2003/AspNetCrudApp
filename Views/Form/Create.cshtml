@model formApp.Models.FormModel

@{
    ViewData["Title"] = "Create Form";
}


<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Create Form</title>
    <link href="~/css/createform.css" rel="stylesheet" />
</head>

<body>

    <div class="container">

        <h2>Create User Form</h2>

        <form asp-action="Create" method="post">

            <div>
                <label>Name</label>
                <input asp-for="Name" placeholder="Enter name" />
                <span asp-validation-for="Name"></span>
            </div>


            <div>
                <label>Email</label>
                <input asp-for="Email" placeholder="Enter email" />
                <span asp-validation-for="Email"></span>
            </div>


            <div>
                <label>Age</label>
                <input asp-for="Age" placeholder="Enter age" />
                <span asp-validation-for="Age"></span>
            </div>


            <div>
                <label>Phone No</label>
                <input asp-for="PhoneNo" placeholder="Enter phone number" />
                <span asp-validation-for="PhoneNo"></span>
            </div>


            <div>
                <label>City</label>
                <input asp-for="City" placeholder="Enter city" />
            </div>


            <div>
                <label>State</label>
                <input asp-for="State" placeholder="Enter state" />
            </div>


            <div>
                <label>Postal Code</label>
                <input asp-for="PostalCode" placeholder="Enter postal code" />
            </div>


            <button type="submit">
                Save
            </button>


        </form>

    </div>


    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

</body>
</html>