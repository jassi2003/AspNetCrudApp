@model formApp.Models.FormModel

@{
    ViewData["Title"] = "Create Form";
}


<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Edit Form</title>
    <link href="~/css/editform.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

</head>

<body>

    <div class="container">
                <div class="form-card-header">
                    <div class="form-header-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" />
                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
                        </svg>
                    </div>
                    <div class="form-header-text">
                        <h1>Edit User Record</h1>
                        <p>Update the information below and save your changes.</p>
                    </div>
                </div>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="form-card">
                <div class="form-body">

                    <div class="section-gap">
                        <div class="form-section-title">Personal Information</div>
                        <div class="form-grid">
                            <div class="field full">
                                <label>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                                    Full Name <span class="required-dot"></span>
                                </label>
                                <input type="text" asp-for="Name" placeholder="Enter full name"/>
                                <span asp-validation-for="Name"></span>
                            </div>
                            <div class="field">
                                <label>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                                    Age
                                </label>
                                <input asp-for="Age" placeholder="Years" min="1" max="120" />
                                <span asp-validation-for="Age"></span>

                            </div>
                            <div class="field">
                                <label>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92V19a2 2 0 01-2.18 2A19.79 19.79 0 013 5.18 2 2 0 015 3h2.09a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 10a16 16 0 006.91 6.91l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 17z" /></svg>
                                    Phone No <span class="required-dot"></span>
                                </label>
                                <input type="tel" asp-for="PhoneNo" placeholder="+91 XXXXXXXXXX" />
                                <span asp-validation-for="PhoneNo"></span>
                            </div>
                        </div>
                    </div>

                    <div class="section-gap">
                        <div class="form-section-title">Contact Details</div>
                        <div class="form-grid">
                            <div class="field full">
                                <label>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                                    Email Address <span class="required-dot"></span>
                                </label>
                                <input type="email" asp-for="Email" placeholder="name@example.com" />
                                <span asp-validation-for="Email"></span>

                            </div>
                        </div>
                    </div>

                    <div class="section-gap">
                        <div class="form-section-title">Address</div>
                        <div class="form-grid">
                            <div class="field">
                                <label>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" /></svg>
                                    City
                                </label>
                                <input type="text" asp-for="City" placeholder="City name" />
                                <span asp-validation-for="City"></span>

                            </div>
                            <div class="field">
                                <label>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /></svg>
                                    State
                                </label>
                                <input type="text" asp-for="State" placeholder="State" />
                                <span asp-validation-for="State"></span>

                            </div>
                            <div class="field">
                                <label>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16" /></svg>
                                    Postal Code
                                </label>
                                <input type="text" asp-for="PostalCode" placeholder="6-digit code" />
                                <span asp-validation-for="PostalCode"></span>

                            </div>
                        </div>
                    </div>

                </div>

                <div class="form-footer">
                    <a  asp-action="Index" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-save">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /><polyline points="7 3 7 8 15 8" /></svg>
                        Save Changes
                    </button>
                </div>
            </div>
        </form>

    </div>
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>